# ─── Banco de dados ───────────────────────────────────────────────
# Por onde o site fala com o banco, no dia a dia.
DATABASE_URL="postgresql://postgres:senha@localhost:5432/studio"

# Por onde passam migrations, constraints e seed. Só precisa existir quando o
# DATABASE_URL acima é um pooler de transação — num Postgres simples as duas
# coisas são o mesmo endereço e esta pode ficar vazia.
#
# Num banco gerenciado com pooler (Supabase), a divisão não é preferência:
#   · DATABASE_URL  → pooler de TRANSAÇÃO (porta 6543). Multiplexa as conexões
#     de todas as instâncias do site. O driver desliga prepared statements
#     sozinho ao ver esta porta — ver packages/db/src/index.ts.
#   · DIRECT_URL    → pooler de SESSÃO (porta 5432). DDL e o advisory lock do
#     drizzle-kit precisam de uma sessão que sobreviva entre comandos.
#
# Nunca o endereço "Direct connection" (db.<ref>.supabase.co): ele só resolve
# em IPv6, a saída da Railway é IPv4, e a falha aparece como timeout sem dizer
# o motivo. Sempre os poolers.
DIRECT_URL=""

# ─── Aplicação ────────────────────────────────────────────────────
NODE_ENV="development"
APP_URL="http://localhost:3000"
# "teste" | "producao". Padrão fechado: sem esta variável, um processo com
# NODE_ENV=production é tratado como produção. Só o ambiente de demonstração
# declara "teste" — é ele que libera o login de cliente sem envio de código e
# o atalho de acesso da demo. Esquecer a variável degrada para o lado seguro.
AMBIENTE="teste"
# Fuso padrão da organização. Cada unidade pode sobrescrever o seu.
DEFAULT_TIMEZONE="America/Sao_Paulo"

# ─── Autenticação ─────────────────────────────────────────────────
# Sem segredo de aplicação: a sessão é token aleatório com hash no banco, e a
# senha é scrypt com salt por usuário. Não há nada para assinar.
OTP_TTL_SECONDS="300"
OTP_MAX_ATTEMPTS="5"

# ─── WhatsApp Cloud API (Meta) ────────────────────────────────────
# Última etapa do produto (ADR-008). A verificação no Meta Business leva
# ~1 semana e precisa ser aberta ANTES de começar esta parte.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# ─── Pagamentos — Asaas (Fase 2) ──────────────────────────────────
ASAAS_API_KEY=""
ASAAS_BASE_URL="https://api-sandbox.asaas.com/v3"
ASAAS_WEBHOOK_TOKEN=""

# ─── Storage de imagem (foto da unidade e do serviço) ─────────────
# Driver do seam em apps/web/src/server/storage/. "local" grava em disco e
# serve por /api/imagens — funciona recém clonado, sem conta em lugar nenhum.
# Com mais de uma instância em produção, disco local não serve (cada máquina
# enxerga só o seu): escreva um driver de bucket e troque esta variável.
IMAGE_STORE="local"
# Onde o driver "local" grava. Padrão: .uploads/ na raiz do processo.
# Em container, aponte para um volume que sobreviva ao deploy.
UPLOAD_DIR=""

# ─── Storage (fotos antes/depois, anexos de chat) ─────────────────
S3_ENDPOINT=""
S3_BUCKET="studio-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"

# ─── E-mail transacional (Resend) ─────────────────────────────────
# As duas juntas ligam o canal de e-mail e, com ele, a área da cliente: é por
# aqui que sai o código de acesso. Faltando qualquer uma, o canal fica
# desligado e a tela de login diz a verdade em vez de fingir que enviou.
# O remetente precisa de domínio verificado no Resend — sem isso o e-mail cai
# no spam ou é recusado. Deixe vazio até o .com.br existir.
RESEND_API_KEY=""
EMAIL_REMETENTE="Nohora Ramirez <nao-responda@seudominio.com.br>"

# ─── Observabilidade ──────────────────────────────────────────────
SENTRY_DSN=""
