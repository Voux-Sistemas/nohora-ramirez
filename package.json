{
  "name": "studio-beleza",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de agendamento e gestão para estúdio de beleza multi-unidade",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@studio/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run generate --workspace=@studio/db",
    "db:migrate": "npm run migrate --workspace=@studio/db && npm run constraints --workspace=@studio/db",
    "db:constraints": "npm run constraints --workspace=@studio/db",
    "db:seed": "npm run seed --workspace=@studio/db",
    "db:inspect": "npm run inspect --workspace=@studio/db",
    "db:studio": "npm run studio --workspace=@studio/db"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
