{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build --workspace=apps/web"
  },
  "deploy": {
    "startCommand": "npm run start --workspace=apps/web",
    "restartPolicyType": "ON_FAILURE",
    "preDeployCommand": "npm run migrate --workspace=@studio/db && npm run constraints --workspace=@studio/db"
  }
}
